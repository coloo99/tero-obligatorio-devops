# Copiar este archivo a .env y completar los valores.
# .env está en .gitignore: NUNCA se sube al repositorio.

# Usuario de PostgreSQL. Dejar retail_user: init-db.sql le da permisos con ese nombre.
DB_USER=retail_user
# Contraseña de PostgreSQL (solo letras y números, 24 caracteres o más).
DB_PASSWORD=

# Credenciales del panel de administración.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# Secreto para firmar los tokens JWT del admin (32 caracteres o más).
ADMIN_JWT_SECRET=
